# ==========================================
# NetPulse Environment Configuration
# ==========================================

# Application
APP_NAME=NetPulse
APP_ENV=development
APP_LOG_LEVEL=INFO

# Java Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# WebSocket
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8081

# Python Bridge
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9000

# Oracle Database
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USERNAME=netpulse
ORACLE_PASSWORD=change_me

# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=netpulse
MYSQL_USERNAME=netpulse
MYSQL_PASSWORD=change_me

# ESP32
ESP32_HOST=127.0.0.1
ESP32_PORT=9001